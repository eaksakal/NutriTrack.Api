<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>nutritrack-api-3f1c6b40-8f2a-4f1d-9a5b-6c2e0d7a91b4</UserSecretsId>
    <!-- Das Vite-Bundle kommt erst im Docker-Build nach wwwroot. Mit aktivierten
         StaticWebAssets wirft der Host beim Start eine DirectoryNotFoundException, solange
         das Verzeichnis fehlt - also bei jedem "dotnet run" und in jedem Test. UseStaticFiles
         selbst kommt mit einem fehlenden wwwroot klaglos zurecht. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <!-- Direkt referenziert, obwohl der Code das Paket nicht selbst anspricht: Microsoft.AspNetCore.
         OpenApi 10.0.4 zieht transitiv Microsoft.OpenApi 2.0.0, und das ist von GHSA-v5pm-xwqc-g5wc
         betroffen (CVE-2026-49451, hoch - eine zirkulaere $ref beendet den Prozess per
         StackOverflow). Eine direkte Referenz gewinnt in NuGet gegen die transitive Forderung und
         ist die einzige Stelle, an der sich die Version heben laesst, ohne auf eine neue
         AspNetCore.OpenApi-Fassung zu warten. 2.7.5 ist die erste gepatchte Version der 2.x-Linie
         (3.x waere ein Hauptversionssprung neben einem Paket, das gegen 2.x gebaut ist).
         WIEDER ENTFERNEN, sobald Microsoft.AspNetCore.OpenApi von sich aus >= 2.7.5 fordert. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NutriTrack.Domain\NutriTrack.Domain.csproj" />
    <ProjectReference Include="..\NutriTrack.Infrastructure\NutriTrack.Infrastructure.csproj" />
  </ItemGroup>

</Project>
