{
  // Auch hier kein Jwt:Key: die Datei ist versioniert, ein Dev-Key waere ein committetes
  // Secret. Lokal setzen mit
  //   dotnet user-secrets set "Jwt:Key" "<48 zufaellige Zeichen>" --project src/NutriTrack.Api
  // oder ueber die Umgebungsvariable NUTRITRACK_Jwt__Key.
  //
  // Die Datenbank landet ohne NUTRITRACK_DATA_ROOT unter src/NutriTrack.Api/data/nutritrack.db.
  "Cors": {
    // Vite-Dev-Server: nur beim lokalen Entwickeln laeuft das Frontend auf einem eigenen Port.
    "Origins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
